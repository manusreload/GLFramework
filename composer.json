{
  "license": "proprietary",
  "name": "gestionlan/planning_jarmauto",
  "description": "",
  "require": {
    "gestionlan/framework": "dev-master",
    "thruway/client": "^0.5",
    "noone-silent/pawl-transport": "^0.5",
    "abcaeffchen/sephpa": "2.0.0-beta1",
    "symfony/translation": "^6.0|^7.0",
    "symfony/var-dumper": "^6.0|^7.0",
    "luecano/numero-a-letras": "3.0.0",
    "postal/postal": "^2.0",
    "phpoffice/phpspreadsheet": "^3.10",
    "smalot/pdfparser": "dev-master"
  },
  "autoload":
  {
    "psr-4": {
      "GLJarmauto\\": "src/"
    },
    "files": [
      "src/funciones.php"
    ]
  },
  "minimum-stability": "dev",
  "extra": {
    "merge-plugin": {
      "include": [
        "vendor/gestionlan/framework/modules/*/composer.json",
        "modules/*/composer.json"
      ]
    }
  },
  "config": {
    "allow-plugins": {
      "wikimedia/composer-merge-plugin": true
    }
  }
}
